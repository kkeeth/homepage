<episodes>
  <div class="episodes">
    <!-- Latest Episode Hero - Compact Layout (fits in first view) -->
    <section class="latest-hero" if={state.latestEpisode && state.currentPage === 1}>
      <div class="hero-inner">
        <!-- Giant Episode Number (decorative) -->
        <div class="episode-number" aria-hidden="true">
          <span class="number-value">#Season</span>
          <span class="number-value">{getEpisodeNumber()}</span>
        </div>

        <!-- Left: Square Artwork -->
        <div class="hero-artwork">
          <a href={"/episodes/" + getEpisodeId(state.latestEpisode)} class="artwork-link">
            <img src={state.latestEpisode.imageUrl || "/placeholder.svg"} alt={state.latestEpisode.title} />
          </a>
        </div>

        <!-- Right: Content -->
        <div class="hero-content">
          <div class="content-inner">
            <span class="section-label">// LATEST EPISODE</span>
            <h1 class="hero-title">
              <a href={"/episodes/" + getEpisodeId(state.latestEpisode)}>{stripSeasonPrefix(state.latestEpisode.title)}</a>
            </h1>
            <p class="hero-date">{state.latestEpisode.pubDate}</p>

            <div class="hero-actions">
              <a href={"/episodes/" + getEpisodeId(state.latestEpisode)} class="hero-play">
                <span class="play-btn">▶</span>
                <span class="play-text">{t("episode.listenOn")}</span>
              </a>

              <!-- Platform Links -->
              <div class="platform-icons">
                <a
                  each={platform in state.platforms}
                  key={platform.name}
                  href={platform.url}
                  target="_blank"
                  class="platform-icon-link platform-{platform.icon}"
                  title={platform.name}
                >
                  <sl-icon name={platform.icon}></sl-icon>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mini header for page 2+ -->
    <section class="mini-header" if={state.currentPage > 1}>
      <div class="mini-header-content">
        <span class="section-label">// EPISODES</span>
        <h1 class="mini-title">{t("pages.episode.hero.title")}</h1>
        <span class="page-indicator">Page {state.currentPage}</span>
      </div>
    </section>

    <section class="episodes-section">
      <div class="section-content">
        <div class="episode-search">
          <label class="search-box">
            <sl-icon name="search"></sl-icon>
            <input
              type="search"
              class="search-input"
              placeholder={t("pages.episode.search.placeholder")}
              aria-label={t("pages.episode.search.placeholder")}
              oninput={onSearchInput}
            />
          </label>
          <p class="search-result" if={state.query} aria-live="polite">
            {state.totalCount
              ? t("pages.episode.search.results").replace('{count}', state.totalCount)
              : t("pages.episode.search.noResults")}
          </p>
        </div>

        <episode-list program-episodes={state.restEpisodes} show-more={false} />

        <pagination
          current-page={state.currentPage}
          page-size={state.pageSize}
          total-count={state.totalCount}
          on-page-change={(page) => handlePageChange(page)}
        />
      </div>
    </section>
  </div>

  <script>
    import episodeStore from '@/stores/episode-store';
    import i18nStore from '@/stores/i18n-store';
    import { PODCAST_PLATFORMS } from '@/constants/links';

    export default {
      t: i18nStore.t.bind(i18nStore),
      state: {
        programEpisodes: [],
        latestEpisode: null,
        restEpisodes: [],
        displayedCount: 0,
        latestEpisodeNumber: 0,
        currentPage: 1,
        query: '',
        totalCount: 0,
        pageSize: 10,
        platforms: PODCAST_PLATFORMS,
      },
      getEpisodeId(episode) {
        if (episode.link) {
          const match = episode.link.match(/episodes\/([a-f0-9-]+)/i);
          if (match) {
            return match[1];
          }
        }
        return encodeURIComponent(episode.title);
      },
      getEpisodeNumber() {
        return this.state.latestEpisodeNumber;
      },
      async onBeforeMount() {
        // 最新回はヒーローに出すので、検索していない 1 ページ目では一覧から外す
        this.syncFromStore = () => {
          const episodes = episodeStore.getDisplayedEpisodes();
          const currentPage = episodeStore.getCurrentPage();
          const query = episodeStore.getQuery();
          const latestEpisode = episodeStore.getLatestEpisode();
          const hideLatestInList = currentPage === 1 && !query;

          this.update({
            programEpisodes: episodes,
            latestEpisode: currentPage === 1 ? latestEpisode : null,
            restEpisodes: hideLatestInList ? episodes.slice(1) : episodes,
            displayedCount: episodeStore.getDisplayedCount(),
            latestEpisodeNumber: latestEpisode ? this.parseSeasonLabel(latestEpisode.title) : 0,
            totalCount: episodeStore.getTotalCount(),
            currentPage,
            query,
            pageSize: episodeStore.getPageSize()
          });
        };

        this.handleEpisodesLoaded = () => {
          episodeStore.setPage(1, 10);
        };

        this.handleEpisodesUpdated = this.syncFromStore;

        this.handlePageChange = (page) => {
          episodeStore.setPage(page, 10);
        };

        episodeStore.on('episodes-loaded', this.handleEpisodesLoaded);
        episodeStore.on('episodes-updated', this.handleEpisodesUpdated);

        await episodeStore.loadAllEpisodes();

        if (episodeStore.getIsInitialized()) {
          this.handleEpisodesLoaded();
        }
      },

      onSearchInput(e) {
        const value = e.target.value;
        clearTimeout(this.searchTimer);
        this.searchTimer = setTimeout(() => episodeStore.setQuery(value), 200);
      },

      parseSeasonLabel(title) {
        const match = title.match(/^Season (\d+-\d+)\.\s*/);
        return match ? match[1] : '';
      },

      stripSeasonPrefix(title) {
        return title.replace(/^Season \d+-\d+\.\s*/, '');
      },

      onBeforeUnmount() {
        clearTimeout(this.searchTimer);
        episodeStore.off('episodes-loaded', this.handleEpisodesLoaded);
        episodeStore.off('episodes-updated', this.handleEpisodesUpdated);
        // 別ページから戻ったときに前回の検索が残らないようにする
        episodeStore.setQuery('');
      }
    }
  </script>
  <style>
    .episodes {
      min-height: 100vh;
    }

    /* ===== Latest Episode Hero (compact) ===== */
    .latest-hero {
      position: relative;
      overflow: hidden;
      background: var(--charcoal);
    }

    .hero-inner {
      position: relative;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: clamp(1.5rem, 3vw, 2.5rem);
      padding: clamp(1.25rem, 2.5vw, 2rem) clamp(1.25rem, 3vw, 2.5rem);
    }

    /* Left: Artwork */
    .hero-artwork {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .artwork-link {
      display: block;
      width: clamp(160px, 20vw, 240px);
      aspect-ratio: 1;
      overflow: hidden;
      box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.6);
      transition: transform 0.3s ease;
    }

    .artwork-link:hover {
      transform: translateY(-3px);
    }

    .artwork-link img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Right: Content */
    .hero-content {
      display: flex;
      align-items: center;
      min-width: 0;
    }

    .content-inner {
      position: relative;
      z-index: 2;
      max-width: 640px;
    }

   /* Giant Episode Number (background decoration) */
   .episode-number {
     position: absolute;
     right: 1.5rem;
     top: 50%;
     transform: translateY(-50%);
     z-index: 1;
     display: flex;
     flex-direction: column;
     align-items: flex-end;
     font-family: var(--font-display);
     font-weight: 700;
     color: rgba(255, 255, 255, 0.04);
     line-height: 1;
     pointer-events: none;
     user-select: none;
   }

   .number-value {
     font-size: clamp(3rem, 7vw, 6rem);
     letter-spacing: -0.03em;
   }

    .section-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--warm-amber);
      letter-spacing: 0.12em;
      margin-bottom: 0.625rem;
      font-family: monospace;
    }

    .hero-title {
      margin: 0 0 0.5rem;
      line-height: 1.25;
    }

    .hero-title a {
      color: white;
      text-decoration: none;
      font-size: clamp(1.5rem, 2.6vw, 2.125rem);
      font-weight: 900;
      line-height: 1.25;
      letter-spacing: -0.01em;
      transition: color 0.2s ease;
    }

    .hero-title a:hover {
      color: var(--paper-deep);
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .hero-date {
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.55);
      margin: 0 0 1.25rem;
      font-family: monospace;
    }

    /* Play + Platforms on one row */
    .hero-actions {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    /* Play Button */
    .hero-play {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 1.25rem 0.5rem 0.5rem;
      background: var(--mint-500);
      border-radius: 4rem;
      color: var(--warm-white);
      text-decoration: none;
      font-weight: 600;
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .hero-play:hover {
      background: var(--mint-400);
      transform: translateY(-2px);
    }

    .play-btn {
      width: 32px;
      height: 32px;
      background: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      color: var(--charcoal);
    }

    .play-text {
      font-size: 0.9375rem;
      letter-spacing: 0.02em;
    }

    /* Platform Links */
    .platform-icons {
      display: flex;
      gap: 0.5rem;
    }

    .platform-icon-link {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      color: rgba(255, 255, 255, 0.6);
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .platform-icon-link:hover {
      transform: translateY(-3px);
      color: white;
    }

    .platform-icon-link sl-icon {
      font-size: 1.125rem;
    }

    .platform-apple:hover { background: #A855F7; border-color: #A855F7; }
    .platform-spotify:hover { background: #1DB954; border-color: #1DB954; }
    .platform-amazon:hover { background: #FF9900; border-color: #FF9900; }
    .platform-youtube:hover { background: #FF0000; border-color: #FF0000; }
    .platform-rss:hover { background: #F97316; border-color: #F97316; }

    /* ===== Mini Header (Page 2+) ===== */
    .mini-header {
      padding: 3rem 4rem 2rem;
      border-bottom: 1px solid var(--light-gray);
    }

    .mini-header .section-label {
      color: var(--rain-blue);
    }

    .mini-header-content {
      max-width: 1200px;
      margin: 0 auto;
    }

    .mini-title {
      font-size: 2.5rem;
      font-weight: 900;
      font-style: italic;
      color: var(--charcoal);
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
    }

    .page-indicator {
      font-size: 0.875rem;
      color: var(--misty-gray);
      font-family: monospace;
    }

    /* ===== Episodes Section ===== */
    .episodes-section {
      background: var(--warm-white);
      padding: 4rem 0;
    }

    .section-content {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* ===== Search ===== */
    .episode-search {
      margin-bottom: 1.5rem;
    }

    .search-box {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 1rem;
      background: var(--paper);
      border: 1px solid var(--rule);
      color: var(--ink-faint);
      transition: border-color 0.2s ease;
    }

    .search-box:focus-within {
      border-color: var(--accent);
      outline: 1px solid var(--accent);
    }

    .search-box sl-icon {
      flex-shrink: 0;
      font-size: 1.125rem;
    }

    .search-input {
      flex: 1;
      min-width: 0;
      border: none;
      outline: none;
      background: transparent;
      font: inherit;
      font-size: 1rem;
      color: var(--ink);
    }

    .search-result {
      margin: 0.75rem 0 0;
      font-size: 0.875rem;
      color: var(--ink-faint);
    }

    /* ===== Mobile ===== */
    @media (max-width: 768px) {
      .section-content {
        padding: 0 1rem;
      }

      .mini-header {
        padding: 2rem 2rem 1.5rem;
      }

      .mini-title {
        font-size: 2rem;
      }
    }

    /* ===== Small Mobile: アートワークを小さくして横並びを維持 ===== */
    @media (max-width: 560px) {
      .hero-inner {
        grid-template-columns: 96px minmax(0, 1fr);
        gap: 1rem;
        padding: 1.25rem 1rem;
      }

      .artwork-link {
        width: 96px;
      }

      .episode-number {
        display: none;
      }

      .section-label {
        margin-bottom: 0.375rem;
      }

      .hero-title a {
        font-size: 1.125rem;
      }

      .hero-date {
        margin-bottom: 0.75rem;
        font-size: 0.75rem;
      }

      .hero-actions {
        gap: 0.75rem;
      }

      .play-text {
        font-size: 0.875rem;
      }

      .mini-header {
        padding: 2rem 1.5rem 1rem;
      }
    }
  </style>
</episodes>
