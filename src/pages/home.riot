<home>
  <div class="home">
    <!-- Hero Section -->
    <hero-section if={state.latestEpisodes[0]} link={state.latestEpisodes[0]} />

    <!-- News Section -->
    <section class="news-section" if={state.news.length}>
      <div class="section-content">
        <span class="section-label">// NEWS</span>
        <h2 class="section-title">{t("pages.home.news.title")}</h2>

        <ul class="news-list">
          <li each={item in state.news} key={item.id} class="news-item">
            <time class="news-date" datetime={item.date.replaceAll('.', '-')}>{item.date}</time>
            <a if={item.url} href={item.url} target="_blank" rel="noopener noreferrer" class="news-text news-link">
              {t(`pages.home.news.items.${item.id}`)}
              <sl-icon name="arrow-up-right"></sl-icon>
            </a>
            <span if={!item.url} class="news-text">{t(`pages.home.news.items.${item.id}`)}</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Latest Episodes Section -->
    <section class="episodes-section">
      <div class="section-content">
        <span class="section-label">// LATEST EPISODES</span>
        <h2 class="section-title">{t("pages.home.episodes.latest.title")}</h2>

        <episode-list program-episodes={state.latestEpisodes} show-more={true} />
      </div>
    </section>

    <!-- Other Episodes - Compact List -->
    <section class="other-programs-section">
      <div class="section-content">
        <span class="section-label">// OTHER PROGRAMS</span>
        <h2 class="section-title">{t("pages.home.episodes.other.title")}</h2>

        <div class="other-programs-list">
          <a
            each={program in state.otherPrograms}
            key={program.id}
            href={program.listen.spotify || program.listen.apple || '#'}
            target="_blank"
            class="other-programs-item"
          >
            <img src={program.artworkUrl} alt={program.title} class="other-programs-artwork" />
            <h3 class="other-programs-name">{program.title}</h3>
            <span class="other-programs-meta">{t("pages.home.categories." + program.category)} · {program.episodes}{t("pages.home.program.episodesCount")}</span>
          </a>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { fetchRSSFeed, getLatestEpisodes } from '@/utils/rss';
    import { OTHER_PROGRAMS, RSS_FEED_URL, SUBSTACK_RSS_URL } from '@/constants/links';
    import { NEWS } from '@/constants/news';
    import i18nStore from '@/stores/i18n-store';

    export default {
      t: i18nStore.t.bind(i18nStore),
      async onBeforeMount() {
        try {
          const [art19, substack] = await Promise.allSettled([
            fetchRSSFeed(RSS_FEED_URL),
            fetchRSSFeed(SUBSTACK_RSS_URL),
          ]);
          const episodes = [
            ...(art19.status === 'fulfilled' ? art19.value : []),
            ...(substack.status === 'fulfilled' ? substack.value : []),
          ].sort((a, b) => b.pubDateObj.getTime() - a.pubDateObj.getTime());
          this.update({ latestEpisodes: getLatestEpisodes(episodes, 3) });
        } catch (error) {
          console.error('Failed to load RSS feed:', error);
        }
      },
      state: {
        latestEpisodes: [],
        otherPrograms: OTHER_PROGRAMS,
        news: NEWS.slice(0, 5),
      },
    }
  </script>

  <style>
    .home {
      min-height: 100vh;
      background: var(--warm-white);
      color: var(--charcoal);
    }

    /* News Section */
    .news-section {
      padding: 4rem 0 1rem;
      background: var(--warm-white);
    }

    .news-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .news-item {
      display: flex;
      gap: 2rem;
      align-items: baseline;
      padding: 1rem 0;
      border-top: 1px solid var(--light-gray);
    }

    .news-item:last-child {
      border-bottom: 1px solid var(--light-gray);
    }

    .news-date {
      flex-shrink: 0;
      width: 6.5rem;
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: var(--misty-gray);
      font-family: var(--font-sans);
    }

    .news-text {
      font-size: 0.9375rem;
      line-height: 1.7;
      color: var(--charcoal);
    }

    .news-link {
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .news-link:hover {
      color: var(--rain-blue);
    }

    .news-link sl-icon {
      font-size: 0.8125rem;
      vertical-align: -0.1em;
      margin-left: 0.25rem;
    }

    /* Other Programs Section */
    .other-programs-section {
      padding: 4rem 0;
      background: var(--warm-white);
      border-top: 1px solid var(--light-gray);
    }

    .other-programs-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
    }

    @media (min-width: 960px) {
      .other-programs-list {
        grid-template-columns: repeat(5, 1fr);
      }
    }

    .other-programs-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding: 1.25rem 1rem;
      background: var(--warm-white);
      border: 1px solid var(--light-gray);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--charcoal);
      text-align: center;
      transition: all 0.2s ease;
    }

    .other-programs-item:hover {
      border-color: var(--rain-blue);
      transform: translateY(-2px);
    }

    .other-programs-artwork {
      width: 80px;
      height: 80px;
      border-radius: 12px;
      object-fit: cover;
      flex-shrink: 0;
    }

    .other-programs-name {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--charcoal);
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      line-height: 1.4;
    }

    .other-programs-meta {
      font-size: 0.75rem;
      color: var(--misty-gray);
    }

    /* Modern Animations */
    @keyframes gentle-float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    @keyframes gentle-rotate {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    @keyframes fade-in-up {
      0% {
        opacity: 0;
        transform: translateY(30px);
      }
      100% {
        opacity: 1;
        transform: translateY(0px);
      }
    }

    @keyframes sound-wave {
      0%, 100% { transform: translateY(-50%) scaleY(1); }
      50% { transform: translateY(-50%) scaleY(1.5); }
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    @keyframes bubble-bounce {
      0%, 100% { transform: translateY(0px) rotate(var(--rotation, 0deg)); }
      50% { transform: translateY(-5px) rotate(var(--rotation, 0deg)); }
    }

    @media (max-width: 480px) {
      .news-item {
        flex-direction: column;
        gap: 0.25rem;
      }

      .other-programs-list {
        grid-template-columns: 1fr;
      }

      .other-programs-item {
        flex-direction: row;
        text-align: left;
        padding: 0.75rem 1rem;
      }

      .other-programs-artwork {
        width: 48px;
        height: 48px;
        border-radius: 8px;
      }

      .other-programs-name {
        font-size: 0.9375rem;
        -webkit-line-clamp: 1;
        white-space: nowrap;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
      }
    }
  </style>
</home>
