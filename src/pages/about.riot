<about>
  <div class="about-page">
    <!-- Hero: イラスト + 自己紹介 -->
    <section class="hero">
      <div class="hero-layout">
        <div class="hero-illustration">
          <img src="/images/myself.png" alt={t("pages.about.illustrationAlt")} />
        </div>
        <div class="hero-text">
          <span class="section-label">// ABOUT</span>
          <h1 class="page-title">{t("pages.about.fullName")}</h1>
          <p class="hero-role">{t("pages.about.role")}</p>
          <p class="about-description"><raw html={t("pages.about.description1")} /></p>
          <p class="about-description"><raw html={t("pages.about.description2")} /></p>
          <div class="hero-actions">
            <a href="/about" class="more-button" onclick={scrollToStory}>{t("pages.about.more")} ↓</a>
            <social-links />
          </div>
        </div>
      </div>
    </section>

    <!-- Story: これまでの歩み + 略歴 -->
    <section class="story-section" id="story">
      <div class="section-inner">
        <span class="section-label">// STORY</span>
        <h2 class="section-title">{t("pages.about.story.sectionTitle")}</h2>
        <div class="story-layout">
          <div class="story-text">
            <p each={key in state.storyParagraphs} key={key}>{t(`pages.about.story.${key}`)}</p>
          </div>
          <div class="story-photo">
            <img src="/images/mypicture.jpeg" alt={t("pages.about.fullName")} />
          </div>
        </div>

        <h3 class="sub-title">{t("pages.about.story.timelineTitle")}</h3>
        <ol class="career-list">
          <li each={item in state.career} key={item.id} class="career-item">
            <span class="career-date">{item.date || t("pages.about.story.now")}</span>
            <div class="career-marker"><span class="career-dot"></span></div>
            <div class="career-body">
              <h4>{t(`pages.about.story.items.${item.id}.title`)}</h4>
              <p if={t(`pages.about.story.items.${item.id}.description`)}>{t(`pages.about.story.items.${item.id}.description`)}</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Values: 大切にしていること -->
    <section class="values-section">
      <div class="section-inner">
        <span class="section-label">// VALUES</span>
        <h2 class="section-title">{t("pages.about.values.sectionTitle")}</h2>
        <div class="values-grid">
          <div each={value in state.values} key={value.id} class="value-item">
            <sl-icon name={value.icon}></sl-icon>
            <h3>{t(`pages.about.values.items.${value.id}.title`)}</h3>
            <p>{t(`pages.about.values.items.${value.id}.description`)}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Appearances: 登壇・出演・協賛 -->
    <section class="appearances-section">
      <div class="section-inner">
        <span class="section-label">// APPEARANCES</span>
        <h2 class="section-title">{t("pages.about.appearances.sectionTitle")}</h2>
        <div class="appearance-grid">
          <a each={item in state.appearances} key={item.id} href={item.url} target="_blank" rel="noopener noreferrer" class="appearance-card">
            <div class="appearance-meta">
              <span class="appearance-type type-{item.type}">{t(`pages.about.appearances.types.${item.type}`)}</span>
              <span class="appearance-year">{item.year}</span>
            </div>
            <h3 class="appearance-title">{t(`pages.about.appearances.items.${item.id}`)}</h3>
            <span class="card-link">{t("pages.about.appearances.cta")} →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Recognition: 肩書き・実績 -->
    <section class="recognition-section">
      <div class="section-inner">
        <span class="section-label">// RECOGNITION</span>
        <h2 class="section-title">{t("pages.about.recognition.sectionTitle")}</h2>
        <div class="recognition-grid">
          <div each={item in state.recognitions} key={item.id} class="recognition-item">
            <span class="recognition-icon"><sl-icon name={item.icon}></sl-icon></span>
            <div>
              <h3>{t(`pages.about.recognition.items.${item.id}.title`)}</h3>
              <p>{t(`pages.about.recognition.items.${item.id}.description`)}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Fun Facts -->
    <section class="facts-section">
      <div class="section-inner">
        <span class="section-label">// FUN FACTS</span>
        <h2 class="section-title">{t("pages.about.funFacts.sectionTitle")}</h2>
        <div class="facts-grid">
          <div each={fact in state.funFacts} key={fact.id} class="fact-card">
            <sl-icon name={fact.icon}></sl-icon>
            <h3>{t(`pages.about.funFacts.items.${fact.id}.title`)}</h3>
            <p><raw html={t(`pages.about.funFacts.items.${fact.id}.description`)} /></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Output Section - Simple Card Grid -->
    <section class="output-section">
      <div class="section-inner">
        <span class="section-label">// OUTPUT</span>
        <h2 class="section-title">{t("pages.about.output.sectionTitle")}</h2>
        <div class="output-grid">
          <a each={output in state.outputs} href={output.url} target="_blank" rel="noopener noreferrer" class="output-card">
            <sl-icon if={output.icon} name={output.icon}></sl-icon>
            <span if={output.textIcon} class="text-icon">{output.textIcon}</span>
            <div class="output-card-body">
              <h3>{t(`pages.about.output.${output.name}.title`)}</h3>
              <p>{t(`pages.about.output.${output.name}.description`)}</p>
            </div>
            <span class="output-card-link">{output.linkText} →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Support Section -->
    <section class="output-section">
      <div class="section-inner">
        <span class="section-label">// SUPPORT</span>
        <h2 class="section-title">{t("pages.about.support.sectionTitle")}</h2>
        <p class="section-description">{t("pages.about.support.description")}</p>
        <div class="output-grid">
          <a each={support in state.supports} href={support.url} target="_blank" rel="noopener noreferrer" class="output-card">
            <sl-icon name={support.icon}></sl-icon>
            <div class="output-card-body">
              <h3>{t(`pages.about.support.${support.name}.title`)}</h3>
              <p>{t(`pages.about.support.${support.name}.description`)}</p>
            </div>
            <span class="output-card-link">{support.linkText} →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Bio Section: 紹介用テキスト (コピー可) -->
    <section class="bio-section">
      <div class="section-inner">
        <span class="section-label">// BIO</span>
        <h2 class="section-title">{t("pages.about.bio.sectionTitle")}</h2>
        <p class="section-description">{t("pages.about.bio.description")}</p>
        <div class="bio-grid">
          <div each={kind in ['short', 'long']} key={kind} class="bio-card">
            <div class="bio-card-header">
              <h3>{t(`pages.about.bio.${kind}Label`)}</h3>
              <button type="button" class="copy-button" onclick={() => copyBio(kind)}>
                <sl-icon name={state.copied === kind ? 'check2' : 'clipboard'}></sl-icon>
                {state.copied === kind ? t("pages.about.bio.copied") : t("pages.about.bio.copy")}
              </button>
            </div>
            <p class="bio-text">{t(`pages.about.bio.${kind}`)}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Request CTA -->
    <section class="request-section">
      <div class="section-inner">
        <span class="section-label">// REQUEST</span>
        <h2 class="section-title">{t("pages.about.request.title")}</h2>
        <p class="section-description">{t("pages.about.request.description")}</p>
        <a href="/contact" class="request-button" onclick={presetRequestTheme}>{t("pages.about.request.button")} →</a>
      </div>
    </section>
  </div>

  <script>
    import { OUTPUT_LINKS, SUPPORT_LINKS, APPEARANCES } from '@/constants/links';
    import i18nStore from '@/stores/i18n-store';

    export default {
      t: i18nStore.t.bind(i18nStore),
      state: {
        storyParagraphs: ['paragraph1', 'paragraph2', 'paragraph3', 'paragraph4'],
        // 略歴 (date なしは「現在」表示)
        career: [
          { id: 'sqbizm', date: '2013.04' },
          { id: 'sqbizmTech', date: '2014.04' },
          { id: 'leprechaun', date: '2015.11' },
          { id: 'yumemi', date: '2017.09' },
          { id: 'yumemiDirector', date: '2020.03' },
          { id: 'podcast', date: '2020.03' },
          { id: 'book', date: '2020.07' },
          { id: 'yumemiExecutive', date: '2022.09' },
          { id: 'kaminashi', date: '2024.04' },
          { id: 'engineeringHr', date: null },
        ],
        values: [
          { id: 'approachable', icon: 'chat-heart' },
          { id: 'shelter', icon: 'umbrella' },
          { id: 'voice', icon: 'mic' },
        ],
        recognitions: [
          { id: 'riotCollaborator', icon: 'github' },
          { id: 'riotJug', icon: 'people' },
          { id: 'author', icon: 'book' },
          { id: 'podcaster', icon: 'broadcast' },
          { id: 'psaSponsor', icon: 'award' },
        ],
        funFacts: [
          { id: 'father', icon: 'balloon-heart' },
          { id: 'generativeArt', icon: 'palette' },
          { id: 'voiceDiary', icon: 'journal-richtext' },
          { id: 'sixShows', icon: 'collection-play' },
        ],
        outputs: OUTPUT_LINKS,
        supports: SUPPORT_LINKS,
        appearances: APPEARANCES,
        copied: null,
      },
      scrollToStory(e) {
        e.preventDefault();
        this.$('#story').scrollIntoView({ behavior: 'smooth' });
      },
      async copyBio(kind) {
        try {
          await navigator.clipboard.writeText(this.t(`pages.about.bio.${kind}`));
          this.update({ copied: kind });
          clearTimeout(this.copiedTimer);
          this.copiedTimer = setTimeout(() => this.update({ copied: null }), 2000);
        } catch (error) {
          console.error('Failed to copy bio:', error);
        }
      },
      // contact ページで「出演・登壇・協賛のご依頼」を初期選択させる
      // (@riotjs/route はクエリ付き URL にマッチしないため sessionStorage で受け渡す)
      presetRequestTheme() {
        try {
          sessionStorage.setItem('contactTheme', 'request');
        } catch (error) {
          // storage が使えない環境では初期選択なしで遷移
        }
      },
      onBeforeUnmount() {
        clearTimeout(this.copiedTimer);
      },
    }
  </script>

  <style>
    .about-page {
      background: var(--warm-white);
      min-height: 100vh;
    }

    .section-inner {
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-description {
      font-size: 0.9375rem;
      line-height: 1.8;
      color: var(--misty-gray);
      margin-bottom: 1.5rem;
    }

    .sub-title {
      font-size: 1.5rem;
      font-weight: 900;
      font-style: italic;
      color: var(--charcoal);
      margin: 4rem 0 2rem;
    }

    .card-link {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--rain-blue);
      font-family: var(--font-sans);
    }

    /* ===== Hero ===== */
    .hero {
      padding: 5rem 4rem;
    }

    .hero-layout {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1.3fr;
      gap: 4rem;
      align-items: center;
    }

    .hero-illustration img {
      width: 100%;
      max-width: 420px;
      display: block;
      margin: 0 auto;
    }

    .hero-role {
      font-size: 1.125rem;
      color: var(--rain-blue);
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    .about-description {
      font-size: 1rem;
      line-height: 1.8;
      color: var(--misty-gray);
      margin-bottom: 1.25rem;
    }

    .about-description a,
    .fact-card a {
      color: var(--rain-blue);
      text-underline-offset: 0.2em;
    }

    .about-description a:hover,
    .fact-card a:hover {
      color: var(--deep-rain);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .more-button {
      display: inline-block;
      padding: 0.75rem 1.75rem;
      border-radius: 2rem;
      background: var(--rain-blue);
      color: var(--warm-white);
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .more-button:hover {
      background: var(--deep-rain);
      transform: translateY(-2px);
    }

    /* ===== Story ===== */
    .story-section {
      padding: 5rem 4rem;
      background: var(--cream);
    }

    .story-layout {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
      align-items: start;
      margin-top: 1rem;
    }

    .story-text p {
      font-size: 1rem;
      line-height: 1.9;
      color: var(--warm-gray);
      margin-bottom: 1.25rem;
    }

    .story-photo img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      border-radius: 1rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .career-list {
      list-style: none;
      padding: 0;
    }

    .career-item {
      display: grid;
      grid-template-columns: 80px 24px 1fr;
      gap: 1.5rem;
      align-items: start;
      padding-bottom: 2rem;
    }

    .career-date {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--rain-blue);
      font-family: var(--font-sans);
      text-align: right;
      padding-top: 0.2rem;
    }

    .career-marker {
      position: relative;
      display: flex;
      justify-content: center;
      height: 100%;
    }

    .career-marker::after {
      content: '';
      position: absolute;
      top: 18px;
      bottom: -2rem;
      width: 2px;
      background: var(--light-gray);
    }

    .career-item:last-child .career-marker::after {
      display: none;
    }

    .career-dot {
      width: 14px;
      height: 14px;
      margin-top: 0.25rem;
      border-radius: 50%;
      background: var(--rain-blue);
      border: 3px solid var(--cream);
      box-shadow: 0 0 0 2px var(--rain-blue);
      z-index: 1;
    }

    .career-item:last-child .career-dot {
      background: var(--warm-amber);
      box-shadow: 0 0 0 2px var(--warm-amber);
    }

    .career-body h4 {
      font-size: 1.0625rem;
      font-weight: 700;
      color: var(--charcoal);
      margin-bottom: 0.25rem;
    }

    .career-body p {
      font-size: 0.875rem;
      line-height: 1.7;
      color: var(--misty-gray);
    }

    /* ===== Values ===== */
    .values-section {
      padding: 5rem 4rem;
    }

    .values-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
      margin-top: 2rem;
    }

    .value-item sl-icon {
      font-size: 2rem;
      color: var(--rain-blue);
      margin-bottom: 1rem;
    }

    .value-item h3 {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--charcoal);
      margin-bottom: 0.75rem;
    }

    .value-item p {
      font-size: 0.9375rem;
      line-height: 1.8;
      color: var(--misty-gray);
    }

    /* ===== Appearances ===== */
    .appearances-section {
      padding: 5rem 4rem;
      background: var(--cream);
    }

    .appearance-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-top: 2rem;
    }

    .appearance-card {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem;
      background: var(--warm-white);
      border: 1px solid var(--light-gray);
      border-radius: 1rem;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .appearance-card:hover {
      border-color: var(--rain-blue);
      transform: translateY(-2px);
    }

    .appearance-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .appearance-type {
      padding: 0.125rem 0.75rem;
      border-radius: 2rem;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--warm-white);
      background: var(--rain-blue);
    }

    .appearance-type.type-sponsor {
      background: var(--warm-amber);
    }

    .appearance-type.type-book {
      background: var(--charcoal);
    }

    .appearance-year {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--misty-gray);
      font-family: var(--font-sans);
    }

    .appearance-title {
      flex: 1;
      font-size: 1.0625rem;
      font-weight: 700;
      line-height: 1.5;
      color: var(--charcoal);
    }

    /* ===== Recognition ===== */
    .recognition-section {
      padding: 5rem 4rem;
    }

    .recognition-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem 3rem;
      margin-top: 2rem;
    }

    .recognition-item {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }

    .recognition-icon {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      border-radius: 50%;
      background: var(--puddle-reflection);
      color: var(--rain-blue);
      font-size: 1.25rem;
    }

    .recognition-item h3 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--charcoal);
      margin-bottom: 0.25rem;
    }

    .recognition-item p {
      font-size: 0.8125rem;
      line-height: 1.6;
      color: var(--misty-gray);
    }

    /* ===== Fun Facts ===== */
    .facts-section {
      padding: 5rem 4rem;
      background: var(--cream);
    }

    .facts-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin-top: 2rem;
    }

    .fact-card {
      padding: 2rem;
      background: var(--warm-white);
      border-radius: 1rem;
    }

    .fact-card sl-icon {
      font-size: 1.75rem;
      color: var(--warm-amber);
      margin-bottom: 0.75rem;
    }

    .fact-card h3 {
      font-size: 1.125rem;
      font-weight: 800;
      color: var(--charcoal);
      margin-bottom: 0.5rem;
    }

    .fact-card p {
      font-size: 0.9375rem;
      line-height: 1.7;
      color: var(--misty-gray);
    }

    /* ===== Output / Support ===== */
    .output-section {
      padding: 5rem 4rem;
      border-top: 1px solid var(--light-gray);
    }

    .output-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .output-card {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem;
      border: 1px solid var(--light-gray);
      border-radius: 1rem;
      text-decoration: none;
      color: var(--charcoal);
      transition: all 0.2s ease;
    }

    .output-card:hover {
      border-color: var(--rain-blue);
      transform: translateY(-2px);
    }

    .output-card sl-icon {
      font-size: 1.5rem;
      flex-shrink: 0;
      color: var(--rain-blue);
    }

    .text-icon {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--rain-blue);
      flex-shrink: 0;
    }

    .output-card-body {
      flex: 1;
      min-width: 0;
    }

    .output-card-body h3 {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }

    .output-card-body p {
      font-size: 0.8125rem;
      color: var(--misty-gray);
      line-height: 1.4;
    }

    .output-card-link {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--rain-blue);
      white-space: nowrap;
      font-family: var(--font-sans);
    }

    /* ===== Bio ===== */
    .bio-section {
      padding: 5rem 4rem;
      border-top: 1px solid var(--light-gray);
    }

    .bio-grid {
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: 1rem;
      align-items: start;
    }

    .bio-card {
      padding: 1.5rem;
      border: 1px solid var(--light-gray);
      border-radius: 1rem;
    }

    .bio-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .bio-card-header h3 {
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--charcoal);
    }

    .copy-button {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.25rem 0.75rem;
      border: 1px solid var(--rain-blue);
      border-radius: 2rem;
      background: transparent;
      color: var(--rain-blue);
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .copy-button:hover {
      background: var(--rain-blue);
      color: var(--warm-white);
    }

    .bio-text {
      font-size: 0.9375rem;
      line-height: 1.8;
      color: var(--misty-gray);
    }

    /* ===== Request CTA ===== */
    .request-section {
      padding: 5rem 4rem;
      background: var(--cream);
    }

    .request-button {
      display: inline-block;
      padding: 0.75rem 2rem;
      border-radius: 2rem;
      background: var(--warm-amber);
      color: var(--warm-white);
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .request-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(255, 152, 0, 0.25);
    }

    /* ===== Responsive ===== */
    @media (max-width: 960px) {
      .appearance-grid,
      .recognition-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .hero,
