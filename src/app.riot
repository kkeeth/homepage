<app>
  <div class={'container page-' + (state.activePage || 'home')}>
    <div class="sheet">
    <router>
      <my-header>
        <nav slot="menu-nav" class="nav desktop-nav sections" aria-label={t("newspaper.nav.label")}>
          <a
            each={(page, index) in navPages()}
            class={state.activePage === page.componentName ? 'active' : '' }
            aria-current={state.activePage === page.componentName ? 'page' : null}
            href={page.path}>{t("newspaper.nav." + page.componentName)}</a>
        </nav>
        <button type="button" slot="menu-button" class="menu-toggle" onclick={ openMenu }>
          <sl-icon name="list" class="hamburger"></sl-icon>
        </button>
      </my-header>

      <sl-drawer placement="end" class="nav-drawer">
        <nav class="nav mobile-nav">
          <ul>
            <li each={(page, index) in navPages()}>
              <a
                class={state.activePage === page.componentName ? 'active' : '' }
                href={page.path}
                onclick={closeMenu}>{t("newspaper.nav." + page.componentName)}</a>
            </li>
          </ul>
        </nav>
        <social-links />
      </sl-drawer>

      <div if={state.showNotFound} class="row">
        <not-found />
      </div>

      <div if={!state.showNotFound} class="app">
        <route each={page in state.pages} path={page.path}>
          <main is={page.componentName} class="main-content" />
          <scroll-top />

          <my-footer />
        </route>
      </div>
    </router>
    </div>
  </div>

  <script>
    import { Router, Route, route, router, toRegexp, match } from '@riotjs/route'
    import NotFound from '@/pages/not-found.riot'
    import pages from './pages'
    import Home from '@/pages/home.riot'
    import Episodes from '@/pages/episodes.riot'
    import Info from '@/pages/info.riot'
    import Profile from '@/pages/profile.riot'
    import Contact from '@/pages/contact.riot'
    import EpisodeDetail from '@/pages/episode-detail.riot'
    import Privacy from '@/pages/privacy.riot'
    import i18nStore from '@/stores/i18n-store';

    export default {
      components : {
        Router,
        Route,
        NotFound,
        Home,
        Episodes,
        Info,
        Profile,
        Contact,
        EpisodeDetail,
        Privacy,
      },
      state: {
        pages,
        showNotFound: false,
        activePage: null,
      },
      onBeforeMount() {
        this.anyRouteStream = route('(.*)')
        this.anyRouteStream.on.value(this.onAnyRoute)

        router.on.value(async (path) => {
          await this.onAnyRoute(path)
          // ページ移動時に画面上部へスクロール
          window.scrollTo({ top: 0, behavior: 'instant' })
        })
      },
      navPages() {
        return pages.filter(p => !p.hidden)
      },
      async onAnyRoute(path) {
        if (!path.pathname) {
          return
        }

        const foundPage = pages.find(p => match(path.pathname, toRegexp(p.path)))
        const activePage = foundPage ? foundPage.componentName : null

        this.update({
          activePage,
          showNotFound: !activePage
        })
      },
      onMounted() {
        i18nStore.on('locale-changed', () => {
          this.update()
        })
      },
      onBeforeUnmount() {
        this.anyRouteStream.end()
      },
      openMenu() {
        this.$('.nav-drawer').show();
      },
      closeMenu() {
        this.$('.nav-drawer').hide();
      }
    }
  </script>

  <style>
    .main-content {
      margin: 0 auto;
    }

    /* 面案内 */
    .sections {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      padding: 8px 0 9px;
    }

    .sections a {
      font-size: 13px;
      letter-spacing: 0.1em;
      text-decoration: none;
      font-weight: 700;
      color: var(--ink);
      padding: 2px 16px;
      border-right: 1px solid var(--ink-faint);
      white-space: nowrap;
    }

    .sections a:last-child {
      border-right: 0;
    }

    .sections a:hover,
    .sections a.active {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .menu-toggle {
      display: none;
      background: none;
      border: 1.5px solid var(--rule);
      color: var(--ink);
      font-size: 1.5rem;
      padding: 2px 6px;
      align-items: center;
      cursor: pointer;
    }

    .nav-drawer::part(panel) {
      background: var(--paper);
      border-left: 3px double var(--rule);
    }

    .nav-drawer::part(body) {
      padding: 2rem 2.5rem;
    }

    .mobile-nav ul {
      padding: 0;
      margin: 0;
    }

    .mobile-nav ul li {
      list-style-type: none;
      border-bottom: 1px dotted var(--ink-faint);
    }

    .mobile-nav ul li a {
      text-decoration: none;
      display: block;
      padding: 0.9rem 0;
      color: var(--ink);
      font-family: var(--font-display);
      font-weight: 900;
      font-size: 1.25rem;
      letter-spacing: 0.08em;
    }

    .mobile-nav ul li a.active {
      color: var(--accent);
    }

    @media (max-width: 768px) {
      .desktop-nav {
        display: none;
      }

      .menu-toggle {
        display: flex;
      }

      .nav-drawer social-links {
        position: absolute;
        bottom: 2rem;
      }
    }
  </style>
</app>