<my-footer>
  <footer class="colophon">
    <div class="double-rule"></div>
    <p class="colo-title">{t("newspaper.masthead.title")}.fm</p>
    <p class="colo-tag">{t("footer.tagline")}</p>

    <dl class="colo-box">
      <dt>{t("newspaper.colophon.publisher")}</dt>
      <dd>{t("newspaper.colophon.publisherValue")}</dd>

      <dt>{t("newspaper.colophon.office")}</dt>
      <dd><a href="https://keeth.me">keeth.me</a>{t("newspaper.colophon.officeValue")}</dd>

      <dt>{t("newspaper.colophon.channels")}</dt>
      <dd>
        <span each={(platform, index) in state.platforms}>
          <a href={platform.url} target="_blank" rel="noopener noreferrer">{platform.name}</a>{index < state.platforms.length - 1 ? ' ・ ' : ''}
        </span>
      </dd>

      <dt>{t("newspaper.colophon.social")}</dt>
      <dd>
        <span each={(link, index) in state.socialLinks}>
          <a
            href={link.url}
            target={link.url.startsWith('mailto:') ? '_self' : '_blank'}
            rel="noopener noreferrer">{link.label}</a>{index < state.socialLinks.length - 1 ? ' ・ ' : ''}
        </span>
      </dd>

      <dt>{t("newspaper.colophon.founded")}</dt>
      <dd>{t("newspaper.colophon.foundedValue")}</dd>
    </dl>

    <p class="colo-fine">
      &copy; {currentYear} kkeeth. {t("footer.rights")}
      <span aria-hidden="true">｜</span>
      <a href="/privacy">{t("footer.legal.privacy")}</a>
    </p>
  </footer>

  <script>
    import i18nStore from '@/stores/i18n-store';
    import { PODCAST_PLATFORMS, SOCIAL_LINKS } from '@/constants/links';

    export default {
      t: i18nStore.t.bind(i18nStore),
      currentYear: new Date().getFullYear(),
      state: {
        platforms: PODCAST_PLATFORMS,
        socialLinks: SOCIAL_LINKS,
      },
    }
  </script>

  <style>
    .colophon {
      margin-top: 34px;
      color: var(--ink);
    }

    .colo-title {
      font-family: var(--font-display);
      font-weight: 900;
      font-size: clamp(20px, 3.2vw, 28px);
      margin: 16px 0 0;
      text-align: center;
    }

    .colo-tag {
      text-align: center;
      font-size: 12.5px;
      letter-spacing: 0.08em;
      color: var(--ink-soft);
      margin: 2px 0 14px;
    }

    .colo-box {
      border: 1px solid var(--rule);
      padding: 14px 18px 12px;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 6px 22px;
      font-size: 12px;
      line-height: 1.7;
      text-align: left;
      max-width: 760px;
      margin: 0 auto;
      background: var(--box-bg);
    }

    .colo-box dt {
      font-weight: 800;
      letter-spacing: 0.14em;
      white-space: nowrap;
    }

    .colo-box dd {
      margin: 0;
      color: var(--ink-soft);
    }

    .colophon a {
      color: inherit;
      text-decoration: none;
    }

    .colophon a:hover {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .colo-fine {
      margin: 12px auto 0;
      max-width: 44em;
      font-size: 11px;
      color: var(--ink-faint);
      line-height: 1.7;
      text-align: center;
    }

    @media (max-width: 760px) {
      .colo-box {
        grid-template-columns: 1fr;
        gap: 2px;
      }

      .colo-box dd {
        margin-bottom: 6px;
      }
    }
  </style>
</my-footer>
