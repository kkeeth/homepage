<episode-list>
  <div class="episode-list">
    <div class="episode-item" each={episode in props.programEpisodes} key={episode.id}>
      <div class="episode-date-col">
        <span class="episode-date">{episode.pubDate}</span>
      </div>
      <div class="episode-content-col">
        <span class="episode-badge" if={parseSeasonLabel(episode.title)}>{parseSeasonLabel(episode.title)}</span>
        <premium-badge show={episode.isPremium} />
        <h3 class="episode-title">
          <a href={"/episodes/" + getEpisodeId(episode)}>{stripSeasonPrefix(episode.title)}</a>
        </h3>
        <p class="episode-description">{truncateText(episode.description, 120)}</p>
      </div>
      <div class="episode-action-col">
        <a
          href={"/episodes/" + getEpisodeId(episode)}
          class="listen-btn"
          aria-label={t("episode.listenOn") + ': ' + stripSeasonPrefix(episode.title)}
        >
          <sl-icon name="play-fill"></sl-icon>
        </a>
        <span class="listen-duration" if={episode.duration}>{formatDuration(episode.duration)}</span>
      </div>
    </div>
  </div>

  <div class="view-all-section" if={props.showMore}>
    <sl-button variant="outline" size="large" href="/episodes" class="view-all-btn">
      {t("components.programCard.viewAll")}
      <sl-icon name="arrow-right" slot="suffix"></sl-icon>
    </sl-button>
  </div>

  <script>
    import { truncateText } from '../utils/truncateText'
    import i18nStore from '@/stores/i18n-store';

    export default {
      t: i18nStore.t.bind(i18nStore),
      truncateText,
      getEpisodeId(episode) {
        // リンクの最後のパスセグメント（Substack は slug）。リンクが無ければタイトル
        if (episode.link) {
          try {
            const segments = new URL(episode.link).pathname.split('/').filter(Boolean);
            if (segments.length > 0) return segments[segments.length - 1];
          } catch {}
        }
        // Fallback to encoded title
        return encodeURIComponent(episode.title);
      },
      parseSeasonLabel(title) {
        const match = title.match(/^(Season \d+-\d+)\.\s*/);
        return match ? match[1] : '';
      },
      stripSeasonPrefix(title) {
        return title.replace(/^Season \d+-\d+\.\s*/, '');
      },
      formatDuration(duration) {
        if (!duration) return '';
        // Handle HH:MM:SS or MM:SS format
        if (duration.includes(':')) {
          const parts = duration.split(':').map(Number);
          if (parts.length === 3) {
            return Math.round(parts[0] * 60 + parts[1] + parts[2] / 60) + 'm';
          }
          if (parts.length === 2) {
            return parts[0] + 'm';
          }
        }
        // Handle seconds format
        const seconds = parseInt(duration);
        if (!isNaN(seconds)) {
          return Math.round(seconds / 60) + 'm';
        }
        return duration;
      }
    }
  </script>

  <style>
    .episode-list {
      display: flex;
      flex-direction: column;
    }

    .episode-item {
      display: grid;
      grid-template-columns: 130px minmax(0, 1fr) auto;
      gap: 2rem;
      align-items: center;
      padding: 2rem 0;
      border-top: 1px solid var(--light-gray);
    }

    .episode-item:last-child {
      border-bottom: 1px solid var(--light-gray);
    }

    /* Date Column */
    .episode-date-col {
      align-self: start;
      padding-top: 0.25rem;
    }

    .episode-date {
      font-size: 1rem;
      font-weight: 500;
      color: var(--storm-cloud);
      letter-spacing: 0.03em;
    }

    /* Content Column */
    .episode-content-col {
      min-width: 0;
    }

    .episode-badge {
      display: inline-block;
      padding: 0.2rem 0.625rem;
      background: var(--deep-rain);
      color: white;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      border-radius: 4px;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
    }

    .episode-title {
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.3;
      margin: 0 0 0.5rem;
    }

    .episode-title a {
      color: var(--text-dark);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .episode-title a:hover {
      color: var(--rain-blue);
    }

    .episode-description {
      font-size: 1rem;
      color: var(--text-color);
      line-height: 1.7;
      margin: 0;
    }

    /* Action Column (right) */
    .episode-action-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.375rem;
    }

    .listen-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 52px;
      height: 52px;
      background: var(--rain-blue);
      color: var(--on-accent, white);
      border-radius: 50%;
      text-decoration: none;
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .listen-btn:hover {
      background: var(--ink, var(--deep-rain));
      transform: scale(1.06);
    }

    .listen-btn sl-icon {
      font-size: 1.5rem;
      margin-left: 3px;
    }

    .listen-duration {
      font-size: 0.75rem;
      color: var(--text-light);
      letter-spacing: 0.04em;
      font-variant-numeric: tabular-nums;
    }

    /* View All */
    .view-all-section {
      text-align: center;
      margin-top: 2rem;
    }

    .view-all-btn::part(base) {
      border: 2px solid var(--warm-amber);
      color: var(--storm-cloud);
      border-radius: 50px;
      padding: 0.75rem 2rem;
      font-weight: 600;
      background: var(--warm-white);
      transition: all 0.3s ease;
    }

    .view-all-btn:hover::part(base) {
      background: var(--warm-amber);
      color: var(--warm-white);
    }

    /* Responsive: Tablet */
    @media (max-width: 768px) {
      .episode-item {
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: 1.25rem;
        row-gap: 0.25rem;
        padding: 1.5rem 0;
      }

      .episode-date-col {
        grid-column: 1 / -1;
        padding-top: 0;
      }

      .episode-title {
        font-size: 1.25rem;
      }
    }

    /* Responsive: Mobile */
    @media (max-width: 480px) {
      .episode-list {
        margin-left: calc(-1 * var(--section-padding, 1rem));
        margin-right: calc(-1 * var(--section-padding, 1rem));
        width: calc(100% + 2 * var(--section-padding, 1rem));
      }

      .episode-item {
        padding: 1.25rem 1rem;
        column-gap: 1rem;
      }

      .episode-title {
        font-size: 1.25rem;
      }

      .episode-description {
        font-size: 1rem;
      }

      .listen-btn {
        width: 44px;
        height: 44px;
      }

      .listen-btn sl-icon {
        font-size: 1.25rem;
      }
    }
  </style>
</episode-list>
