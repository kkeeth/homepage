<episode-list>
  <div class="episode-list">
    <a
      class="episode-item"
      each={episode in props.programEpisodes}
      key={episode.id}
      href={"/episodes/" + getEpisodeId(episode)}
    >
      <div class="episode-thumb">
        <img
          src={episode.imageUrl || FALLBACK_ARTWORK}
          alt=""
          loading="lazy"
          onerror={onThumbError}
        />
        <span class="episode-thumb-play"><sl-icon name="play-fill"></sl-icon></span>
      </div>
      <div class="episode-body">
        <p class="episode-meta">
          <span class="episode-badge" if={parseSeasonLabel(episode.title)}>{parseSeasonLabel(episode.title)}</span>
          <span>{episode.pubDate}</span>
          <span if={episode.duration}>{formatDuration(episode.duration)}</span>
          <premium-badge show={isEpisodePremium(episode)} />
        </p>
        <h3 class="episode-title">{stripSeasonPrefix(episode.title)}</h3>
        <p class="episode-description">{truncateText(episode.description, 120)}</p>
      </div>
    </a>
  </div>

  <div class="view-all-section" if={props.showMore}>
    <sl-button variant="outline" size="large" href="/episodes" class="view-all-btn">
      {t("components.programCard.viewAll")}
      <sl-icon name="arrow-right" slot="suffix"></sl-icon>
    </sl-button>
  </div>

  <script>
    import { truncateText } from '../utils/truncateText'
    import i18nStore from '@/stores/i18n-store';

    // RSS にエピソード画像が無い / 読み込み失敗時は番組アートワークを表示
    const FALLBACK_ARTWORK = '/images/web_talk.png';

    export default {
      t: i18nStore.t.bind(i18nStore),
      truncateText,
      FALLBACK_ARTWORK,
      onThumbError(e) {
        if (!e.target.src.endsWith(FALLBACK_ARTWORK)) e.target.src = FALLBACK_ARTWORK;
      },
      isEpisodePremium(episode) {
        return episode.isPremium === true;
      },
      getEpisodeId(episode) {
        if (episode.link) {
          try {
            const segments = new URL(episode.link).pathname.split('/').filter(Boolean);
            if (segments.length > 0) return segments[segments.length - 1];
          } catch {}
        }
        return encodeURIComponent(episode.title);
      },
      parseSeasonLabel(title) {
        const match = title.match(/^(Season \d+-\d+)\.\s*/);
        return match ? match[1] : '';
      },
      stripSeasonPrefix(title) {
        return title.replace(/^Season \d+-\d+\.\s*/, '');
      },
      formatDuration(duration) {
        if (!duration) return '';
        // Handle HH:MM:SS or MM:SS format
        if (duration.includes(':')) {
          const parts = duration.split(':').map(Number);
          if (parts.length === 3) {
            return Math.round(parts[0] * 60 + parts[1] + parts[2] / 60) + 'm';
          }
          if (parts.length === 2) {
            return parts[0] + 'm';
          }
        }
        // Handle seconds format
        const seconds = parseInt(duration);
        if (!isNaN(seconds)) {
          return Math.round(seconds / 60) + 'm';
        }
        return duration;
      }
    }
  </script>

  <style>
    .episode-list {
      display: flex;
      flex-direction: column;
    }

    .episode-item {
      display: flex;
      gap: 2.25rem;
      padding: 2.75rem 0;
      border-top: 1px solid var(--light-gray);
      text-decoration: none;
      color: inherit;
    }

    .episode-item:last-child {
      border-bottom: 1px solid var(--light-gray);
    }

    /* Thumbnail */
    .episode-thumb {
      position: relative;
      flex-shrink: 0;
      width: 160px;
      aspect-ratio: 1 / 1;
      border-radius: 0.5rem;
      overflow: hidden;
      background: var(--cream);
    }

    .episode-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .episode-thumb-play {
      position: absolute;
      right: 0.5rem;
      bottom: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      background: var(--rain-blue);
      color: white;
      font-size: 1.25rem;
      opacity: 0;
      transform: translateY(4px);
      transition: all 0.2s ease;
    }

    .episode-item:hover .episode-thumb-play,
    .episode-item:focus-visible .episode-thumb-play {
      opacity: 1;
      transform: translateY(0);
    }

    /* Body */
    .episode-body {
      flex: 1;
      min-width: 0;
      padding-top: 0.125rem;
    }

    .episode-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      margin: 0 0 0.75rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--misty-gray);
      letter-spacing: 0.03em;
    }

    .episode-badge {
      display: inline-block;
      margin-right: 0.75rem;
      padding: 0.25rem 0.625rem;
      background: var(--deep-rain);
      color: white;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      border-radius: 4px;
      text-transform: uppercase;
    }

    .episode-meta > span:not(.episode-badge) + span::before {
      content: '·';
      margin: 0 0.5rem;
    }

    .episode-title {
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.4;
      margin: 0 0 0.75rem;
      color: var(--text-dark);
      transition: color 0.2s ease;
    }

    .episode-item:hover .episode-title {
      color: var(--rain-blue);
    }

    .episode-description {
      font-size: 1rem;
      color: var(--text-color);
      line-height: 1.8;
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* View All */
    .view-all-section {
      text-align: center;
      margin-top: 2rem;
    }

    .view-all-btn::part(base) {
      border: 2px solid var(--warm-amber);
      color: var(--storm-cloud);
      border-radius: 50px;
      padding: 0.75rem 2rem;
      font-weight: 600;
      background: var(--warm-white);
      transition: all 0.3s ease;
    }

    .view-all-btn:hover::part(base) {
      background: var(--warm-amber);
      color: var(--warm-white);
    }

    /* Responsive: Tablet */
    @media (max-width: 768px) {
      .episode-item {
        gap: 1.5rem;
        padding: 2.25rem 0;
      }

      .episode-thumb {
        width: 120px;
      }

      .episode-title {
        font-size: 1.3125rem;
      }
    }

    /* Responsive: Mobile */
    @media (max-width: 480px) {
      .episode-item {
        gap: 1rem;
        padding: 1.75rem 0;
      }

      .episode-thumb {
        width: 84px;
      }

      .episode-thumb-play {
        display: none;
      }

      .episode-meta {
        font-size: 0.8125rem;
        margin-bottom: 0.5rem;
      }

      .episode-title {
        font-size: 1.125rem;
        margin-bottom: 0;
      }

      .episode-description {
        display: none;
      }
    }
  </style>
</episode-list>
